#!/bin/bash
set -euo pipefail

# Read the current file from stdin
current=$(cat)

# Extract the [maintenance] section from the current file (if any)
maintenance=$(echo "$current" | awk '
  /^\[maintenance\]/ { found=1 }
  found { print }
  /^\[/ && !/^\[maintenance\]/ && found { found=0 }
' | awk '
  /^\[maintenance\]/ { found=1 }
  found && /^\[/ && !/^\[maintenance\]/ { exit }
  found { print }
')

# Output the managed config
cat <<'EOF'
[alias]
	br = "for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'"
	l = "log --pretty=format:'%C(cyan)%h%Creset %C(green)%ad%Creset %C(yellow)%an%Creset: %C(reset)%s' --date=short --abbrev-commit"

[core]
	editor = "vim"

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	showForcedUpdates = true
EOF

# Append the preserved [maintenance] section if it exists
if [ -n "$maintenance" ]; then
  echo ""
  echo "$maintenance"
fi
